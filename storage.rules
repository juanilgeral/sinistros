rules_version = '2';

// Sistema de Sinistros — Juanil Transportes Rodoviários
// Só usuários autenticados podem enviar/baixar anexos.
// Limite de 250MB por arquivo (fotos, documentos escaneados e vídeos curtos).
//
// IMPORTANTE: leitura e escrita ficam em regras SEPARADAS.
// "request.resource" só existe em operações de escrita (upload) —
// se fosse usado numa regra combinada de "read, write", toda
// tentativa de LEITURA (abrir/baixar um arquivo já enviado) quebraria
// a avaliação da regra e seria negada por padrão.
service firebase.storage {
  match /b/{bucket}/o {
    match /sinistros/{protocolo}/{categoria}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 250 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
